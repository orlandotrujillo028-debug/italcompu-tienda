# Copia este archivo como .env y completa los valores.

# Base de datos PostgreSQL (Neon: https://neon.tech -> Connect)
# DATABASE_URL: conexión CON pooler (host termina en -pooler), la usa la tienda
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL: conexión directa (sin -pooler), la usa Prisma para migraciones
DIRECT_URL="postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js: genera uno con  npx auth secret
AUTH_SECRET=""

# Cloudinary (imágenes de productos)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# URL pública de la tienda (en producción: https://italcompu.ec). Se usa en los enlaces de
# WhatsApp, el mapa del sitio y las vistas previas al compartir.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# En Vercel configura estas mismas variables (ver PUBLICAR.md). Los datos de contacto,
# WhatsApp, IVA, envío y datos bancarios NO van aquí: se editan en Admin → Configuración.
