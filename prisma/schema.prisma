// Esquema de base de datos de ITALCOMPU
// Después de cambiarlo: npx prisma migrate dev --name <descripcion>

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────── Usuarios y autenticación ─────────────

// ADMIN: dueño (todo) · VENDEDOR: personal de ITALCOMPU (productos y pedidos)
// CLIENTE: comprador; si tiene DistributorProfile APROBADO ve precios de distribuidor.
enum Rol {
  ADMIN
  VENDEDOR
  CLIENTE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // hash bcrypt (null si entra con Google)
  telefono      String?
  cedula        String? // cédula o RUC
  rol           Rol       @default(CLIENTE)
  activo        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  distribuidor DistributorProfile?
  addresses    Address[]
  orders       Order[]
  wishlist     WishlistItem[]
  actividad    ActivityLog[]

  @@index([rol])
}

// Modelos requeridos por Auth.js (@auth/prisma-adapter)
model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ───────────── Distribuidores ─────────────
// Un CLIENTE que tiene un local del mismo giro puede solicitar ser distribuidor.
// Cuando el ADMIN lo aprueba, ve los precios con el descuento "descuento_distribuidor" (Setting).

enum EstadoDistribuidor {
  PENDIENTE
  APROBADO
  RECHAZADO
  SUSPENDIDO
}

model DistributorProfile {
  id            String             @id @default(cuid())
  userId        String             @unique
  razonSocial   String
  nombreLocal   String
  ruc           String             @unique
  tipoNegocio   String // ej. "Tienda de computación", "Servicio técnico"
  provincia     String
  ciudad        String
  direccion     String?
  telefono      String
  estado        EstadoDistribuidor @default(PENDIENTE)
  motivoRechazo String?
  aprobadoEn    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([estado])
}

// ───────────── Catálogo ─────────────

model Category {
  id       String  @id @default(cuid())
  nombre   String
  slug     String  @unique
  icono    String? // nombre de icono lucide (ej. "laptop")
  imagen   String?
  orden    Int     @default(0)
  activa   Boolean @default(true)
  parentId String?

  parent   Category?  @relation("Subcategorias", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("Subcategorias")
  products Product[]

  @@index([parentId])
}

model Brand {
  id       String    @id @default(cuid())
  nombre   String    @unique
  slug     String    @unique
  logo     String?
  products Product[]
}

enum EstadoProducto {
  BORRADOR
  PENDIENTE
  PUBLICADO
  RECHAZADO
}

model Product {
  id            String         @id @default(cuid())
  codigo        String         @unique // SKU
  nombre        String
  slug          String         @unique
  descripcion   String?
  specs         Json? // [{ "clave": "RAM", "valor": "16 GB" }]
  precioSinIva  Decimal        @db.Decimal(10, 2)
  stock         Int            @default(0)
  estado        EstadoProducto @default(PENDIENTE)
  motivoRechazo String?
  destacado     Boolean        @default(false)
  nuevo         Boolean        @default(false)
  garantiaMeses Int            @default(12)
  categoryId    String
  brandId       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  category   Category       @relation(fields: [categoryId], references: [id])
  brand      Brand?         @relation(fields: [brandId], references: [id])
  images     ProductImage[]
  orderItems OrderItem[]
  wishlist   WishlistItem[]

  @@index([estado, categoryId])
  @@index([estado, brandId])
  @@index([destacado])
  @@index([nuevo])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  orden     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model WishlistItem {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

// ───────────── Clientes y pedidos ─────────────

model Address {
  id         String  @id @default(cuid())
  userId     String
  nombre     String // quien recibe
  telefono   String
  provincia  String
  ciudad     String
  direccion  String
  referencia String?
  principal  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum EstadoPedido {
  PENDIENTE_PAGO
  PAGADO
  PREPARANDO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum MetodoPago {
  TARJETA
  TRANSFERENCIA
  CONTRA_ENTREGA
}

model Order {
  id                    String       @id @default(cuid())
  numero                Int          @unique @default(autoincrement()) // número legible: #1001
  userId                String
  estado                EstadoPedido @default(PENDIENTE_PAGO)
  metodoPago            MetodoPago
  referenciaPago        String?
  // % de descuento de distribuidor aplicado en este pedido (0 = precio público)
  descuentoDistribuidor Decimal      @default(0) @db.Decimal(5, 2)
  subtotal              Decimal      @db.Decimal(10, 2) // sin IVA
  iva                   Decimal      @db.Decimal(10, 2)
  envio                 Decimal      @db.Decimal(10, 2)
  total                 Decimal      @db.Decimal(10, 2)
  direccionEnvio        Json // copia de la dirección al momento de comprar
  courier               String?
  guiaEnvio             String?
  notas                 String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@index([estado, createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String
  nombre       String // copia del nombre al momento de comprar
  codigo       String
  precioSinIva Decimal @db.Decimal(10, 2) // precio cobrado (ya con descuento si era distribuidor)
  cantidad     Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// ───────────── Contenido y configuración ─────────────

model Banner {
  id        String   @id @default(cuid())
  titulo    String
  subtitulo String?
  imagen    String
  enlace    String?
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Setting {
  clave String @id // ej. "iva", "costo_envio", "descuento_distribuidor"
  valor String
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  accion    String // ej. "producto.aprobado"
  detalle   String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
